{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noImplicitAny": false,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "types": [],
        "rootDirs": [
            ".",
            "./core"
        ],
        "preserveSymlinks": true,
        "paths": {
            "@woogidex/host": [
                "./js/host.ts"
            ],
            "react": [
                "./node_modules/@types/react"
            ],
            "react/*": [
                "./node_modules/@types/react/*"
            ],
            "react-dom": [
                "./node_modules/@types/react-dom"
            ],
            "react-dom/*": [
                "./node_modules/@types/react-dom/*"
            ]
        }
    },
    "include": [
        "js/**/*",
        "core/js/**/*",
        "core/vite-env.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "core/node_modules",
        "core/js/host/standalone.ts"
    ]
}
